# 4. Environment variables & secrets
.env
.env.*
!.env.example
.streamlit/secrets.toml

# 5. Operating System files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# 6. IDE & Local Editor caches
.idea/
.vscode/
*.swp
*.swo
*~

# 7. Temporary log & debug text files
*.log
debug_*.txt

